# 复制为 .env 后填写真实值。.env 含密钥，已被 .gitignore 忽略，请勿提交。
#   cp .env.example .env

# ============================================================
# 业务后台服务 (backend_api) 配置
# ============================================================
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=8000

# 业务数据库 (SQLAlchemy)
# 本地：sqlite+aiosqlite:///./backend.db
# Postgres：postgresql+asyncpg://用户名:密码@主机:5432/数据库名
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# AI Service 的访问地址（backend_api 调用）
AI_SERVICE_BASE_URL=http://localhost:8100

# ============================================================
# AI 工作流服务 (ai_service) 配置
# ============================================================
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100

# LangGraph Checkpointer 数据库 (PostgreSQL) —— 必填
# 格式：postgresql://用户名:密码@主机:5432/数据库名
# 该 database 需提前存在；启动时会自动建 checkpoints 等四张表
LANGGRAPH_CHECKPOINT_DSN=postgresql://用户名:密码@主机:5432/数据库名

# 火山方舟 (Ark) 大模型配置 —— 真实调用必填
# API Key 申请：https://www.volcengine.com/docs/82379/1399008
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 语言模型的推理接入点 ID
ARK_MODEL=ep-xxxxxxxxxxxxx
# 文生图模型（doubao-seedream）
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128

# ============================================================
# Brave Search MCP Server（联网搜索，用于选题生成）
# ============================================================
# 启动命令：BRAVE_API_KEY=xxx npx -y @brave/brave-search-mcp-server --transport http --port 8200
# 申请 API Key：https://api-dashboard.search.brave.com
BRAVE_MCP_URL=http://localhost:8200/mcp
