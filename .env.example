# ============================================================
# 业务后台服务 (backend_api) 配置
# ============================================================
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=8000

# 业务数据库 (SQLAlchemy)
# 本地快速验证可使用 sqlite，例如：sqlite+aiosqlite:///./backend.db
# 生产/docker-compose 使用 postgres：postgresql+asyncpg://agent:agent@postgres:5432/agent
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# AI Service 的访问地址（backend_api 调用）
AI_SERVICE_BASE_URL=http://localhost:8100

# ============================================================
# AI 工作流服务 (ai_service) 配置
# ============================================================
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100

# LangGraph Checkpointer 数据库 (Postgres)
# 留空则自动 fallback 到 InMemorySaver（进程重启即丢失，仅适合本地 mock 验证）
# 配置后启动时会自动建 checkpoints / checkpoint_blobs / checkpoint_writes / checkpoint_migrations 四张表
# 格式：postgresql://用户名:密码@主机:5432/数据库名
LANGGRAPH_CHECKPOINT_DSN=

# 是否使用 Mock LLM/绘图（true=mock，false=真实调用）
USE_MOCK_LLM=true
USE_MOCK_IMAGE=true

# 火山方舟 (Ark) 大模型配置
# API Key 申请：https://www.volcengine.com/docs/82379/1399008
# 当 USE_MOCK_LLM=false 时必须填写 ARK_API_KEY
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=ep-20260516141907-ggmpz
# 文生图模型（USE_MOCK_IMAGE=false 时生效）
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
