# ============================================================
# 业务后台服务 (backend_api) 配置
# ============================================================
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=8000

# 业务数据库 (SQLAlchemy)
# 本地快速验证可使用 sqlite，例如：sqlite+aiosqlite:///./backend.db
# 生产/docker-compose 使用 postgres：postgresql+asyncpg://agent:agent@postgres:5432/agent
DATABASE_URL=sqlite+aiosqlite:///./backend.db

# AI Service 的访问地址（backend_api 调用）
AI_SERVICE_BASE_URL=http://localhost:8100

# ============================================================
# AI 工作流服务 (ai_service) 配置
# ============================================================
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100

# LangGraph Checkpointer 数据库 (Postgres)
# 留空则自动 fallback 到 MemorySaver，便于本地快速验证 mock 流程
# 示例：postgresql://agent:agent@postgres:5432/agent
LANGGRAPH_CHECKPOINT_DSN=

# 是否使用 Mock LLM/绘图（true=mock，false=真实调用）
USE_MOCK_LLM=true
USE_MOCK_IMAGE=true
